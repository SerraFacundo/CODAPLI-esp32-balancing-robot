          },
          "query": "from(bucket: \"robot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"estado\" and r._field == \"caidas\")\n  |> last()"
        }
