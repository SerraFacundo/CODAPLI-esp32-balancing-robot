            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 10,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-robot"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Últimas caídas",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-robot"
          },
          "query": "from(bucket: \"robot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"caida\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, \"Caída #\": r.numero, \"Ángulo (°)\": r.angulo, \"De pie antes (s)\": float(v: r.tramo_ms) / 1000.0}))\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 20)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 11,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-robot"
      },
      "gridPos": {
        "x": 0,
