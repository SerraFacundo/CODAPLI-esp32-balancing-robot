    {
      "type": "timeseries",
      "title": "Caídas por minuto",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-robot"
          },
          "query": "from(bucket: \"robot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"caida\" and r._field == \"numero\")\n  |> group()\n  |> aggregateWindow(every: 1m, fn: count, createEmpty: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
