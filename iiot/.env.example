# Copiar a .env y cambiar los valores. .env está en .gitignore: no se sube al repo.
INFLUX_USER=admin
INFLUX_PASSWORD=cambiar-esta-clave
INFLUX_ORG=utn-frlp
INFLUX_BUCKET=robot
INFLUX_TOKEN=cambiar-este-token-largo

GRAFANA_USER=admin
GRAFANA_PASSWORD=cambiar-esta-clave

# IP del robot en la red de la laptop (modo AP+STA). En modo solo-AP: ws://192.168.4.1/ws
ROBOT_WS_URL=ws://192.168.4.1/ws
